{
  "name": "radish-security-notes",
  "version": "1.1.0",
  "description": "本地加密的桌面密码与笔记保险库 (Electron, React, TypeScript)",
  "main": "./out/main/index.js",
  "author": "auYe",
  "license": "MIT",
  "homepage": "https://github.com/auYeCoding/radish-security-notes#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/auYeCoding/radish-security-notes.git"
  },
  "bugs": {
    "url": "https://github.com/auYeCoding/radish-security-notes/issues"
  },
  "keywords": [
    "password-manager",
    "secure-notes",
    "electron",
    "sqlcipher",
    "totp",
    "windows"
  ],
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache . && npm run lint:css",
    "lint:css": "stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@node-rs/argon2": "2.2.1",
    "@scure/bip39": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "age-encryption": "^0.3.1",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.45.3",
    "electron-store": "^11.0.2",
    "i18next": "^26.4.2",
    "i18next-icu": "^2.4.4",
    "intl-messageformat": "^11.2.15",
    "lucide-react": "^1.49.0",
    "nodemailer": "^10.0.15",
    "otpauth": "^9.5.2",
    "pseudo-localization": "^3.1.3",
    "react-hook-form": "^7.89.0",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15",
    "zxing-wasm": "^3.1.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "drizzle-kit": "^0.31.11",
    "electron": "44.5.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-jsdoc": "^65.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^30.1.1",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "shadcn": "^4.21.1",
    "stylelint": "^17.16.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
